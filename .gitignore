# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environment files (never commit real credentials)
.env
.env.local

# IDE / editor
.vscode/
.idea/
*.swp

# OS artifacts
.DS_Store
Thumbs.db

# Local databases
*.db
*.sqlite
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Generated data — the pipeline recreates these from the public source
data/raw/fhir/*.json
data/processed/fhir/*.csv
data/raw/*.csv
data/processed/*.csv

# But keep the .gitkeep files so the folder structure is preserved
!data/raw/fhir/.gitkeep
!data/processed/fhir/.gitkeep